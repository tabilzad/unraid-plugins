#!/usr/bin/env bash
# validate: check the Community Applications feed before Community Applications
# does. Needs xmllint (libxml2) and curl.
#
#   scripts/validate [--offline]
#
# Checks ca_profile.xml (well formed, non-empty Profile, Icon reachable), the
# LICENSE file, every plugins/*.xml (a plugin wrapper) and every templates/*.xml
# (a Docker app template).
#
# Wrapper: well formed, the required fields present, PluginURL an https URL
# that is reachable and byte-for-byte the pluginURL attribute of the plg it
# points at.
# Template: well formed, the required fields present, TemplateURL the file's
# own raw URL in this repository, every Config entry complete, the WebUI port
# published by a Port entry, and the image tag present on Docker Hub (an image
# on another registry is reported and not checked).
# Both: Icon a reachable PNG, every Screenshot reachable.
#
# --offline skips the network checks. Exit 1 on findings.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Where Community Applications reads this repository from. A template's
# TemplateURL must be its own path under this.
feed_raw=https://raw.githubusercontent.com/tabilzad/unraid-plugins/main

offline=0
[ "${1:-}" = --offline ] && offline=1

fail=0
err() {
  printf 'validate: %s\n' "$*" >&2
  fail=1
}
note() {
  printf 'validate: note: %s\n' "$*" >&2
}
xp() { # FILE XPATH
  xmllint --noent --xpath "$2" "$1" 2>/dev/null || true
}
fetch() { # URL OUT
  curl -fsSL --proto '=https' --tlsv1.2 --max-time 60 -o "$2" "$1"
}
is_png() { # FILE
  [ "$(head -c 8 -- "$1" | od -An -tx1 | tr -d ' \n')" = "89504e470d0a1a0a" ]
}
check_art() { # FILE ROOT: the Icon is a reachable PNG, every Screenshot is reachable
  local f=$1 root=$2 icon n i shot
  icon=$(xp "$f" "normalize-space(/$root/Icon)")
  if fetch "$icon" "$tmp/icon"; then
    is_png "$tmp/icon" || err "$f: Icon is not a PNG: $icon"
  else
    err "$f: Icon is not reachable: $icon"
  fi
  n=$(xp "$f" "count(/$root/Screenshot)")
  for ((i = 1; i <= ${n:-0}; i++)); do
    shot=$(xp "$f" "normalize-space(/$root/Screenshot[$i])")
    fetch "$shot" "$tmp/shot" || err "$f: Screenshot is not reachable: $shot"
  done
}
check_image() { # FILE IMAGE: the tag exists on Docker Hub
  local f=$1 ref=$2 name tag
  case "$ref" in
    *@*)
      note "$f: image $ref is pinned by digest, not checked"
      return 0
      ;;
  esac
  name=$ref
  tag=latest
  case "${ref##*/}" in
    *:*)
      tag=${ref##*:}
      name=${ref%:*}
      ;;
  esac
  case "$name" in
    */*)
      # A first component with a dot or a colon, or "localhost", is a registry host.
      case "${name%%/*}" in
        *.* | *:* | localhost)
          note "$f: image $ref is not on Docker Hub, not checked"
          return 0
          ;;
      esac
      ;;
    *) name=library/$name ;;
  esac
  fetch "https://hub.docker.com/v2/repositories/$name/tags/$tag" "$tmp/tag" ||
    err "$f: Docker Hub has no image $name with the tag $tag"
}

for tool in xmllint curl; do
  command -v "$tool" >/dev/null || {
    printf 'validate: %s is required\n' "$tool" >&2
    exit 2
  }
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

[ -f LICENSE ] || err "LICENSE is missing (Community Applications requires an OSI-approved licence at the root)"

if xmllint --noout ca_profile.xml 2>/dev/null; then
  [ -n "$(xp ca_profile.xml 'normalize-space(/CommunityApplications/Profile)')" ] || err "ca_profile.xml: Profile is empty"
  profile_icon=$(xp ca_profile.xml 'normalize-space(/CommunityApplications/Icon)')
  if [ -n "$profile_icon" ] && [ "$offline" = 0 ]; then
    if fetch "$profile_icon" "$tmp/profile-icon"; then
      is_png "$tmp/profile-icon" || err "ca_profile.xml: Icon is not a PNG: $profile_icon"
    else
      err "ca_profile.xml: Icon is not reachable: $profile_icon"
    fi
  fi
else
  err "ca_profile.xml is missing or not well formed"
fi

shopt -s nullglob
wrappers=(plugins/*.xml)
templates=(templates/*.xml)
[ "$((${#wrappers[@]} + ${#templates[@]}))" -gt 0 ] || err "no wrappers under plugins/ and no templates under templates/"

for w in "${wrappers[@]}"; do
  if ! xmllint --noout "$w" 2>/dev/null; then
    err "$w is not well formed"
    continue
  fi
  [ -n "$(xp "$w" 'name(/*)')" ] && [ "$(xp "$w" 'name(/*)')" = Plugin ] || err "$w: the root element must be <Plugin>"
  for el in Name PluginURL PluginAuthor Overview Category Icon License; do
    [ -n "$(xp "$w" "normalize-space(/Plugin/$el)")" ] || err "$w: <$el> is missing or empty"
  done
  url=$(xp "$w" 'normalize-space(/Plugin/PluginURL)')
  icon=$(xp "$w" 'normalize-space(/Plugin/Icon)')
  case "$url" in
    https://*) ;;
    *) err "$w: PluginURL must be an https URL: '$url'" ;;
  esac
  case "$icon" in
    https://*) ;;
    *) err "$w: Icon must be an https URL: '$icon'" ;;
  esac
  [ "$offline" = 1 ] && continue

  if fetch "$url" "$tmp/plg"; then
    if xmllint --noout --noent "$tmp/plg" 2>/dev/null; then
      plg_url=$(xp "$tmp/plg" 'string(/PLUGIN/@pluginURL)')
      [ "$plg_url" = "$url" ] || err "$w: PluginURL '$url' differs from the plg's pluginURL '$plg_url'"
      plg_name=$(xp "$tmp/plg" 'string(/PLUGIN/@name)')
      [ -n "$plg_name" ] || err "$w: the plg at $url has no name attribute"
    else
      err "$w: the file at $url is not a well-formed plg"
    fi
  else
    err "$w: PluginURL is not reachable: $url"
  fi
  check_art "$w" Plugin
done

for t in "${templates[@]}"; do
  if ! xmllint --noout "$t" 2>/dev/null; then
    err "$t is not well formed"
    continue
  fi
  [ "$(xp "$t" 'name(/*)')" = Container ] || err "$t: the root element must be <Container>"
  for el in Name Repository Support Project Overview Category TemplateURL Icon License; do
    [ -n "$(xp "$t" "normalize-space(/Container/$el)")" ] || err "$t: <$el> is missing or empty"
  done
  image=$(xp "$t" 'normalize-space(/Container/Repository)')
  icon=$(xp "$t" 'normalize-space(/Container/Icon)')
  template_url=$(xp "$t" 'normalize-space(/Container/TemplateURL)')
  webui=$(xp "$t" 'normalize-space(/Container/WebUI)')
  [ "$template_url" = "$feed_raw/$t" ] || err "$t: TemplateURL must be $feed_raw/$t, not '$template_url'"
  case "$icon" in
    https://*) ;;
    *) err "$t: Icon must be an https URL: '$icon'" ;;
  esac
  incomplete=$(xp "$t" "count(/Container/Config[not(@Name) or @Name='' or not(@Target) or @Target='' or not(@Type='Port' or @Type='Path' or @Type='Variable' or @Type='Label' or @Type='Device')])")
  [ "$incomplete" = 0 ] || err "$t: $incomplete Config element(s) lack a Name, a Target or a known Type"
  if [[ $webui =~ \[PORT:([0-9]+)\] ]]; then
    port=${BASH_REMATCH[1]}
    [ "$(xp "$t" "count(/Container/Config[@Type='Port'][@Target='$port'])")" = 1 ] ||
      err "$t: WebUI uses port $port, which no Port entry publishes"
  fi
  [ "$offline" = 1 ] && continue

  check_image "$t" "$image"
  check_art "$t" Container
done

if [ "$fail" = 0 ]; then
  printf 'validate: ok (%d wrapper(s), %d template(s)%s)\n' "${#wrappers[@]}" "${#templates[@]}" "$([ "$offline" = 1 ] && printf ', offline')"
fi
exit "$fail"
